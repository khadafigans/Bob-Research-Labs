# Bob Research Labs — Environment Variables
# Copy to .env and fill in values

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=CHANGE_ME

# LLM API Keys (set one or configure via UI after login)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: LLM overrides
# ARTEX_LLM_PROVIDER=anthropic
# ARTEX_LLM_MODEL=claude-3-5-sonnet-20241022
# ARTEX_LLM_BASE_URL=
# ARTEX_LLM_PROXY=

# Optional: override PostgreSQL DSN entirely
# ARTEX_PG_DSN=postgres://reaper_user:password@127.0.0.1:5432/reaper?sslmode=disable
